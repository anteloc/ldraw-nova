{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LDraw agent assembly plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "author", "sections"],
  "properties": {
    "version": {"const": 1},
    "author": {"$ref": "#/$defs/text"},
    "license": {"$ref": "#/$defs/text"},
    "sections": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/section"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n\\x00]+$"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]*\\.ldr$", "maxLength": 200},
    "vector": {"type": "array", "items": {"type": "number", "minimum": -1000000, "maximum": 1000000}, "minItems": 3, "maxItems": 3},
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "description", "steps"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "description": {"$ref": "#/$defs/text"},
        "steps": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/placement"}}}
      }
    },
    "placement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "ref", "colour"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "purpose": {"$ref": "#/$defs/text"},
        "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]*\\.(dat|ldr)$", "maxLength": 200},
        "colour": {"type": "integer", "minimum": 0},
        "at": {"$ref": "#/$defs/vector"},
        "yaw": {"type": "number", "minimum": -360, "maximum": 360},
        "matrix": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/vector"}},
        "on": {"type": "string", "minLength": 1},
        "offset_studs": {"type": "array", "items": {"type": "number", "minimum": -1000, "maximum": 1000}, "minItems": 2, "maxItems": 2}
      },
      "oneOf": [
        {"required": ["at"], "not": {"anyOf": [{"required": ["on"]}, {"required": ["offset_studs"]}]}},
        {"required": ["on"], "not": {"required": ["at"]}}
      ],
      "not": {"required": ["yaw", "matrix"]}
    }
  }
}
