{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LDraw modular assembly plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "author",
    "sections"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "author": {
      "$ref": "#/$defs/text"
    },
    "license": {
      "$ref": "#/$defs/text"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "includes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/text"
      },
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/text"
          },
          {
            "$ref": "#/$defs/flex_asset"
          }
        ]
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n\\x00]+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]*\\.ldr$",
      "maxLength": 200
    },
    "vector": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1000000,
        "maximum": 1000000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "steps"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/placement"
            }
          }
        },
        "author": {
          "$ref": "#/$defs/text"
        },
        "license": {
          "$ref": "#/$defs/text"
        },
        "anchors": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/frame"
          }
        },
        "structure": {
          "oneOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "$ref": "#/$defs/named_structure"
            }
          ]
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "colour"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "purpose": {
          "$ref": "#/$defs/text"
        },
        "ref": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]*\\.(dat|ldr)$",
              "maxLength": 200
            },
            {
              "type": "string",
              "pattern": "^@[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$",
              "maxLength": 300
            }
          ]
        },
        "colour": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^@colours\\.[A-Za-z_][A-Za-z0-9_]*$"
            }
          ]
        },
        "at": {
          "$ref": "#/$defs/vector"
        },
        "yaw": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "matrix": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/vector"
          }
        },
        "on": {
          "type": "string",
          "minLength": 1
        },
        "offset_studs": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000,
            "maximum": 1000
          },
          "minItems": 2,
          "maxItems": 2
        },
        "attach": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "to",
            "anchor",
            "using"
          ],
          "properties": {
            "to": {
              "$ref": "#/$defs/text"
            },
            "anchor": {
              "$ref": "#/$defs/text"
            },
            "using": {
              "$ref": "#/$defs/text"
            },
            "offset": {
              "$ref": "#/$defs/vector"
            }
          }
        },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "step"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "step": {
              "$ref": "#/$defs/vector"
            }
          }
        },
        "snap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "to"
          ],
          "properties": {
            "to": {
              "$ref": "#/$defs/text"
            },
            "near": {
              "$ref": "#/$defs/vector"
            },
            "moving_leaf": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99999
            },
            "fixed_leaf": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99999
            },
            "candidate": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "moving_feature": {
              "$ref": "#/$defs/text"
            },
            "fixed_feature": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "flex": {
          "$ref": "#/$defs/inline_flex"
        }
      },
      "oneOf": [
        {
          "required": [
            "at",
            "ref"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "on"
                ]
              },
              {
                "required": [
                  "attach"
                ]
              },
              {
                "required": [
                  "offset_studs"
                ]
              },
              {
                "required": [
                  "snap"
                ]
              },
              {
                "required": [
                  "flex"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "on",
            "ref"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "at"
                ]
              },
              {
                "required": [
                  "attach"
                ]
              },
              {
                "required": [
                  "repeat"
                ]
              },
              {
                "required": [
                  "snap"
                ]
              },
              {
                "required": [
                  "flex"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "attach",
            "ref"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "at"
                ]
              },
              {
                "required": [
                  "on"
                ]
              },
              {
                "required": [
                  "offset_studs"
                ]
              },
              {
                "required": [
                  "matrix"
                ]
              },
              {
                "required": [
                  "yaw"
                ]
              },
              {
                "required": [
                  "repeat"
                ]
              },
              {
                "required": [
                  "snap"
                ]
              },
              {
                "required": [
                  "flex"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "snap",
            "ref"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "at"
                ]
              },
              {
                "required": [
                  "on"
                ]
              },
              {
                "required": [
                  "attach"
                ]
              },
              {
                "required": [
                  "offset_studs"
                ]
              },
              {
                "required": [
                  "repeat"
                ]
              },
              {
                "required": [
                  "flex"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "flex"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "ref"
                ]
              },
              {
                "required": [
                  "at"
                ]
              },
              {
                "required": [
                  "on"
                ]
              },
              {
                "required": [
                  "attach"
                ]
              },
              {
                "required": [
                  "snap"
                ]
              },
              {
                "required": [
                  "yaw"
                ]
              },
              {
                "required": [
                  "matrix"
                ]
              },
              {
                "required": [
                  "offset_studs"
                ]
              },
              {
                "required": [
                  "repeat"
                ]
              }
            ]
          }
        }
      ],
      "not": {
        "required": [
          "yaw",
          "matrix"
        ]
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/vector"
        },
        "matrix": {
          "$ref": "#/$defs/placement/properties/matrix"
        }
      }
    },
    "flex_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "namespace"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/text"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 100
        },
        "checks": {
          "$ref": "#/$defs/flex_checks"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "flex_checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_radius": {
          "type": "number",
          "minimum": 0
        },
        "max_turn": {
          "type": "number",
          "minimum": 0
        },
        "min_separation": {
          "type": "number",
          "minimum": 0
        },
        "length": {
          "type": "number",
          "minimum": 0
        },
        "length_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "tube_radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "block": {
          "type": "integer",
          "minimum": 1
        },
        "obstacles": {
          "$ref": "#/$defs/text"
        },
        "obstacle_section": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "named_structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "version": {
          "const": 1
        },
        "require_rigid": {
          "type": "boolean"
        },
        "required_joints": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "between"
            ],
            "properties": {
              "between": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$"
                },
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true
              },
              "minimum": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          }
        },
        "assembly": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "connector",
              "before"
            ],
            "properties": {
              "connector": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$"
              },
              "before": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        },
        "scope": {
          "enum": [
            "structure",
            "joints"
          ]
        },
        "retained_axles": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10000,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "joints"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "require_rigid": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "flex_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part"
      ],
      "properties": {
        "part": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$"
        },
        "port": {
          "$ref": "#/$defs/text"
        },
        "feature": {
          "$ref": "#/$defs/text"
        },
        "at": {
          "$ref": "#/$defs/vector"
        },
        "outward": {
          "$ref": "#/$defs/vector"
        },
        "up": {
          "$ref": "#/$defs/vector"
        },
        "lead": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "oneOf": [
        {
          "required": [
            "port"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "feature"
                ]
              },
              {
                "required": [
                  "at"
                ]
              },
              {
                "required": [
                  "outward"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "feature"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "port"
                ]
              },
              {
                "required": [
                  "at"
                ]
              },
              {
                "required": [
                  "outward"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "at",
            "outward"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "port"
                ]
              },
              {
                "required": [
                  "feature"
                ]
              }
            ]
          }
        }
      ]
    },
    "flex_waypoint": {
      "oneOf": [
        {
          "$ref": "#/$defs/vector"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at"
          ],
          "properties": {
            "at": {
              "$ref": "#/$defs/vector"
            },
            "direction": {
              "$ref": "#/$defs/vector"
            },
            "up": {
              "$ref": "#/$defs/vector"
            }
          }
        }
      ]
    },
    "inline_flex_checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_radius": {
          "type": "number",
          "minimum": 0
        },
        "max_turn": {
          "type": "number",
          "minimum": 0
        },
        "min_separation": {
          "type": "number",
          "minimum": 0
        },
        "length": {
          "type": "number",
          "minimum": 0
        },
        "length_tolerance": {
          "type": "number",
          "minimum": 0
        },
        "tube_radius": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "inline_flex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "$ref": "#/$defs/text"
        },
        "from": {
          "$ref": "#/$defs/flex_endpoint"
        },
        "to": {
          "$ref": "#/$defs/flex_endpoint"
        },
        "via": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/flex_waypoint"
          }
        },
        "wheels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 200,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*$"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "control"
                ],
                "properties": {
                  "control": {
                    "enum": [
                      "INSIDE",
                      "OUTSIDE",
                      "CROSS"
                    ]
                  }
                }
              }
            ]
          }
        },
        "checks": {
          "$ref": "#/$defs/inline_flex_checks"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "from",
            "to"
          ],
          "not": {
            "required": [
              "wheels"
            ]
          }
        },
        {
          "required": [
            "wheels"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "from"
                ]
              },
              {
                "required": [
                  "to"
                ]
              },
              {
                "required": [
                  "via"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
