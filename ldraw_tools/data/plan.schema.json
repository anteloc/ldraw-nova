{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LDraw modular assembly plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "author",
    "sections"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "author": {
      "$ref": "#/$defs/text"
    },
    "license": {
      "$ref": "#/$defs/text"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "includes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/text"
      },
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/text"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n\\x00]+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]*\\.ldr$",
      "maxLength": 200
    },
    "vector": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1000000,
        "maximum": 1000000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "steps"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "$ref": "#/$defs/placement"
            }
          }
        },
        "author": {
          "$ref": "#/$defs/text"
        },
        "license": {
          "$ref": "#/$defs/text"
        },
        "anchors": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/frame"
          }
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ref",
        "colour"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "purpose": {
          "$ref": "#/$defs/text"
        },
        "ref": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]*\\.(dat|ldr)$",
              "maxLength": 200
            },
            {
              "type": "string",
              "pattern": "^@[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$",
              "maxLength": 300
            }
          ]
        },
        "colour": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^@colours\\.[A-Za-z_][A-Za-z0-9_]*$"
            }
          ]
        },
        "at": {
          "$ref": "#/$defs/vector"
        },
        "yaw": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "matrix": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/vector"
          }
        },
        "on": {
          "type": "string",
          "minLength": 1
        },
        "offset_studs": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1000,
            "maximum": 1000
          },
          "minItems": 2,
          "maxItems": 2
        },
        "attach": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "to",
            "anchor",
            "using"
          ],
          "properties": {
            "to": {
              "$ref": "#/$defs/text"
            },
            "anchor": {
              "$ref": "#/$defs/text"
            },
            "using": {
              "$ref": "#/$defs/text"
            },
            "offset": {
              "$ref": "#/$defs/vector"
            }
          }
        },
        "repeat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "step"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "step": {
              "$ref": "#/$defs/vector"
            }
          }
        },
        "snap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "to"
          ],
          "properties": {
            "to": {
              "$ref": "#/$defs/text"
            },
            "near": {
              "$ref": "#/$defs/vector"
            },
            "moving_leaf": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99999
            },
            "fixed_leaf": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99999
            },
            "candidate": {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            "moving_feature": {
              "$ref": "#/$defs/text"
            },
            "fixed_feature": {
              "$ref": "#/$defs/text"
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "at"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "on"
                ]
              },
              {
                "required": [
                  "attach"
                ]
              },
              {
                "required": [
                  "offset_studs"
                ]
              },
              {
                "required": [
                  "snap"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "on"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "at"
                ]
              },
              {
                "required": [
                  "attach"
                ]
              },
              {
                "required": [
                  "repeat"
                ]
              },
              {
                "required": [
                  "snap"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "attach"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "at"
                ]
              },
              {
                "required": [
                  "on"
                ]
              },
              {
                "required": [
                  "offset_studs"
                ]
              },
              {
                "required": [
                  "matrix"
                ]
              },
              {
                "required": [
                  "yaw"
                ]
              },
              {
                "required": [
                  "repeat"
                ]
              },
              {
                "required": [
                  "snap"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "snap"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "at"
                ]
              },
              {
                "required": [
                  "on"
                ]
              },
              {
                "required": [
                  "attach"
                ]
              },
              {
                "required": [
                  "offset_studs"
                ]
              },
              {
                "required": [
                  "repeat"
                ]
              }
            ]
          }
        }
      ],
      "not": {
        "required": [
          "yaw",
          "matrix"
        ]
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at"
      ],
      "properties": {
        "at": {
          "$ref": "#/$defs/vector"
        },
        "matrix": {
          "$ref": "#/$defs/placement/properties/matrix"
        }
      }
    }
  }
}
