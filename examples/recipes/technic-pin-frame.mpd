0 FILE technic-pin-frame.ldr
0 Rigid Technic chassis: two rails pinned to an open frame at two holes each
0 Name: technic-pin-frame.ldr
0 Author: ldraw-nova recipe
0 !LDRAW_ORG Model
0 // frame: 5 x 7 open frame lying flat; its corner holes run vertically (Y)
1 71 0 0 0 1 0 0 0 1 0 0 0 1 64179.dat
0 STEP
0 // rail-left: 7-long rail on the frame's left side; two pinned holes make the joint rigid
1 72 -40 -20 0 1 0 0 0 1 0 0 0 1 32524.dat
0 // rail-left-pin-0: 2780.dat
1 0 -40 -10 -60 0 1 0 -1 0 0 0 0 1 2780.dat
0 // rail-left-pin-1: 2780.dat
1 0 -40 -10 60 0 1 0 -1 0 0 0 0 1 2780.dat
0 STEP
0 // rail-right: Matching rail on the right side
1 72 40 -20 0 1 0 0 0 1 0 0 0 1 32524.dat
0 // rail-right-pin-0: 2780.dat
1 0 40 -10 -60 0 1 0 -1 0 0 0 0 1 2780.dat
0 // rail-right-pin-1: 2780.dat
1 0 40 -10 60 0 1 0 -1 0 0 0 0 1 2780.dat
0 NOFILE
