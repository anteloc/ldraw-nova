0 ROTATION CONFIG 0 0
0 // Technic Brick 1 x 4 with Holes (light_grey)
1 7 0 -24 0 1 0 0 0 1 0 0 0 1 3701.dat
0 // Technic Axle Pin (light_grey)
1 7 0 -14 -10 0 0 1 0 1 0 -1 0 0 3749.dat
0 STEP
0 // Technic Gear 24 Tooth with 3 Axleholes (light_grey)
1 7 0 -14 -20 0 -1 0 -1 0 0 0 0 -1 3648a.dat
0 STEP
0 // Technic Axle 4 (black)
1 0 0 -30 -50 0 0.7071 0.7071 0 0.7071 -0.7071 -1 0 0 3705.dat
1 7 0 -30 -50 -1 0 0 0 0 1 0 1 0 study-e0c6a5968275-03-8855---Piston.ldr
0 STEP
0 NOFILE
