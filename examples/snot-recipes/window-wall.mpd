0 FILE window-wall.ldr
0 Window frame and glass between brick columns under a lintel plate
0 Name: window-wall.ldr
0 Author: ldraw-nova recipe
0 !LDRAW_ORG Model
0 // sill: 1 x 4 plate carrying the window and both columns
1 19 0 0 0 1 0 0 0 1 0 0 0 1 3710.dat
0 STEP
0 // column-left: Brick 1 x 1 on stud 0 (x = -30)
1 19 -30 -24 0 1 0 0 0 1 0 0 0 1 3005.dat
0 // column-right: Brick 1 x 1 on stud 3 (x = 30)
1 19 30 -24 0 1 0 0 0 1 0 0 0 1 3005.dat
0 // frame: Window 1 x 2 x 2 on the two middle studs; it is two bricks (48 LDU) tall
1 15 0 -48 0 1 0 0 0 1 0 0 0 1 60592.dat
0 STEP
0 // glass: Glass shares the frame's origin: the frame sits 48 LDU above the sill top
1 47 0 -48 0 1 0 0 0 1 0 0 0 1 60601.dat
0 // column-left-2: Second course
1 19 -30 -48 0 1 0 0 0 1 0 0 0 1 3005.dat
0 // column-right-2: Second course
1 19 30 -48 0 1 0 0 0 1 0 0 0 1 3005.dat
0 STEP
0 // lintel: Plate across the frame and both columns: socket 1 (x = -10) on the frame's first stud
1 19 0 -56 0 1 0 0 0 1 0 0 0 1 3710.dat
0 NOFILE
